# Copy this file to ".env" and fill in real values. Never upload ".env" to GitHub.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Long random secret used to sign login tokens (at least 32 characters)
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# How long a login token stays valid (e.g. 24h, 7d)
JWT_EXPIRES_IN="24h"

# Allowed front-end addresses, comma separated. "*" allows everyone (development only).
CORS_ORIGIN="http://localhost:5173"

# Port for the server (cloud services usually set this automatically)
PORT=3000

# development | production | test
NODE_ENV=development

# Password for the demo accounts created by the seed.
# Required when NODE_ENV=production; in development the default is Demo1234
SEED_PASSWORD=""
